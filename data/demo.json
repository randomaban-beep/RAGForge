{
  "description": "Hand-authored fictional operations handbook. Development fixture, not a held-out benchmark.",
  "documents": [
    {
      "id": "retention",
      "text": "Operational logs are retained for 30 days. Audit logs are retained for 365 days.",
      "metadata": {
        "source": "retention.md"
      }
    },
    {
      "id": "backup",
      "text": "Database backups run every six hours. Backup restoration drills take place monthly.",
      "metadata": {
        "source": "backup.md"
      }
    },
    {
      "id": "access",
      "text": "Production access requires single sign-on and multifactor authentication. Access reviews happen quarterly.",
      "metadata": {
        "source": "access.md"
      }
    },
    {
      "id": "incident",
      "text": "Severity one incidents must be acknowledged within 15 minutes. The on-call engineer leads the incident response.",
      "metadata": {
        "source": "incident.md"
      }
    },
    {
      "id": "refund",
      "text": "Customers can request a refund within 14 days of their initial purchase. Renewal payments are non-refundable.",
      "metadata": {
        "source": "refund.md"
      }
    },
    {
      "id": "upload",
      "text": "Document uploads support PDF, DOCX, TXT, and Markdown. The maximum size per file is 10 MiB.",
      "metadata": {
        "source": "upload.md"
      }
    },
    {
      "id": "encryption",
      "text": "Stored customer files use AES-256 encryption. Transport connections require TLS 1.2 or newer.",
      "metadata": {
        "source": "encryption.md"
      }
    },
    {
      "id": "deployment",
      "text": "A deployment requires passing unit tests and retrieval quality gates. A failed quality gate blocks release.",
      "metadata": {
        "source": "deployment.md"
      }
    },
    {
      "id": "rate",
      "text": "The public API allows 120 requests per minute per account. Rate-limited requests receive HTTP status 429.",
      "metadata": {
        "source": "rate.md"
      }
    },
    {
      "id": "deletion",
      "text": "Account deletion removes customer documents within seven days. Audit records follow their separate retention policy.",
      "metadata": {
        "source": "deletion.md"
      }
    },
    {
      "id": "support",
      "text": "Technical support operates Monday through Friday from 09:00 to 18:00 UTC. Critical incidents have round-the-clock on-call coverage.",
      "metadata": {
        "source": "support.md"
      }
    },
    {
      "id": "keys",
      "text": "API keys must be rotated every 90 days. Keys must never be committed to source control.",
      "metadata": {
        "source": "keys.md"
      }
    }
  ],
